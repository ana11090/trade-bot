# Python
__pycache__/
*.pyc
*.pyo

# Large ML artifacts (keep small configs and CSVs)
*.pkl
trade_histories/*/project1_results/scenarios/*/*.png

# Raw tick imports (used as input by build_candles_from_ticks.py)
# stay excluded — they're hundreds of MB and not needed at runtime.
xauusd/ticks/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Indicator cache files (large parquet, rebuilt automatically)
data/.cache_*
*.parquet

# Large output files
project1_reverse_engineering/outputs/strategy_search_results.json

# Phase A: Exclude large candle CSV files (keep metadata only)
datasets/*/candles/*.csv
project1_reverse_engineering/outputs/smart_feature_matrix.csv

# Source CSVs are tracked via git-lfs (see .gitattributes).
# Tick files INSIDE a data source ARE tracked (via LFS) so they
# propagate across machines for the spread-filter parity. See
# .gitattributes for the LFS rule. Previously excluded — moved to
# May 2026 once the spread filter started needing real bid/ask.
xauusd/Files xauusd levereged/*.csv
xauusd/xauusd unlimited levereged/*.csv
# Large output files
project2_backtesting/outputs/backtest_trades_*.json
